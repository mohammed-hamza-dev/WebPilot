{
  "manifest_version": 3,
  "name": "WebPilot",
  "version": "1.0.0",
  "description": "WebPilot browser automation extension",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
